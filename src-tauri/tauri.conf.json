{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Einhorn-Lernspiele",
  "version": "0.1.6",
  "identifier": "de.crilabs.lernen-spielen",
  "build": {
    "frontendDist": "../spiele"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Einhorn-Lernspiele",
        "fullscreen": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required",
        "create": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Crilabs/lernen-spielen/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDNEZBOUEyRjI0QTA4MjIKUldRaUNFcnlvcWxQN0JJQ3k1ck9qdytOMkpBVHJUMW5xcjg3S2V2bTFVV3BZOE16eXZ6VDVTeUsK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
